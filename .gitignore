# Model and checkpoint artifacts: ignored by default unless explicitly allowlisted below.
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
*.onnx

# Local model/data/runtime material.
/checkpoints/
/models/
/weights/
/datasets/
/data/
/cache/
/hf-cache/
/logs/
/videos/

# The two small residual checkpoints are intentionally versioned.
!/checkpoints/
!/checkpoints/*.pt
*.mp4
*.npz
*.npy

# Python and local tooling.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
build/
*.egg-info/

# Local configuration and secrets.
.env
.env.*
*.pem
*.key
*secret*
*password*
